cc4756257245b840c6581387756eceecce6","filename":"res/res_pjsip_pubsub.c","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/asterisk/asterisk/blob/7a1ffcdf38cc76d1c4eae51651667f3fd4548ab0/res%2Fres_pjsip_pubsub.c","raw_url":"https://github.com/asterisk/asterisk/raw/7a1ffcdf38cc76d1c4eae51651667f3fd4548ab0/res%2Fres_pjsip_pubsub.c","contents_url":"https://api.github.com/repos/asterisk/asterisk/contents/res%2Fres_pjsip_pubsub.c?ref=7a1ffcdf38cc76d1c4eae51651667f3fd4548ab0","patch":"@@ -3886,7 +3886,7 @@ static int parse_simple_message_summary(char *body,\n \t\t\t&summary->voice_messages_urgent_new, &summary->voice_messages_urgent_old)) {\n \t\t\tfound_counts = 1;\n \t\t} else {\n-\t\t\tsscanf(line, \"message-account: %s\", summary->message_account);\n+\t\t\tsscanf(line, \"message-account: %511s\", summary->message_account);\n \t\t}\n \t}\n "}]}