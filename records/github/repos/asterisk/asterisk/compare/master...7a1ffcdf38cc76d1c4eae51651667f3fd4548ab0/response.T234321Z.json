thub.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"parents":[{"sha":"ad5b8ee1a168310224e3699dc91eef7bb4ee2b53","url":"https://api.github.com/repos/asterisk/asterisk/commits/ad5b8ee1a168310224e3699dc91eef7bb4ee2b53","html_url":"https://github.com/asterisk/asterisk/commit/ad5b8ee1a168310224e3699dc91eef7bb4ee2b53"}]},"merge_base_commit":{"sha":"7a1ffcdf38cc76d1c4eae51651667f3fd4548ab0","node_id":"C_kwDOAgOC1doAKDdhMWZmY2RmMzhjYzc2ZDFjNGVhZTUxNjUxNjY3ZjNmZDQ1NDhhYjA","commit":{"author":{"name":"Milan Kyselica","email":"mil.kyselica@gmail.com","date":"2026-03-24T18:22:02Z"},"committer":{"name":"George Joseph","email":"gtjoseph@users.noreply.github.com","date":"2026-06-25T14:21:09Z"},"message":"res_pjsip_pubsub: Add width limit to sscanf in MWI NOTIFY parser\n\nThe parse_simple_message_summary() function uses sscanf with an\nunbounded %s format specifier to parse the Message-Account field\nfrom incoming SIP NOTIFY bodies into a fixed-size 512-byte stack\nbuffer (PJSIP_MAX_URL_SIZE). A single unauthenticated SIP NOTIFY\nwith a Message-Account value exceeding 512 bytes overflows the\nbuffer, corrupting adjacent stack data and permanently disabling\nthe PJSIP transport layer without crashing the process.\n\nAdd a width specifier (%511s) to limit the sscanf write to\nPJSIP_MAX_URL_SIZE - 1 bytes plus the NUL terminator, matching\nthe destination buffer size.\n\nResolves: #GHSA-589g-qgf8-m6mx","tree":{"sha":"fa5b2de8a9805b8cda3dde0cb811fcba2ac37584","url":"https://api.github.com/repos/asterisk/asterisk/git/trees/fa5b2de8a9805b8cda3dde0cb811fcba2ac37584"},"url":"https://api.github.com/repos/asterisk/asterisk/git/commits/7a1ffcdf38cc76d1c4eae51651667f3fd4548ab0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/ast