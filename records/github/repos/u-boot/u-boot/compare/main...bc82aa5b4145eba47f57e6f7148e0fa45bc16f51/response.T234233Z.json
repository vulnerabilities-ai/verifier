ase_commit":{"sha":"bc82aa5b4145eba47f57e6f7148e0fa45bc16f51","node_id":"C_kwDOAZTsr9oAKGJjODJhYTViNDE0NWViYTQ3ZjU3ZTZmNzE0OGUwZmE0NWJjMTZmNTE","commit":{"author":{"name":"Heinrich Schuchardt","email":"heinrich.schuchardt@canonical.com","date":"2026-06-01T13:20:53Z"},"committer":{"name":"Heinrich Schuchardt","email":"heinrich.schuchardt@canonical.com","date":"2026-06-07T14:43:06Z"},"message":"efi_loader: validate PE-COFF relocation data\n\nWhen applying base relocations from a PE-COFF binary all data must\nbe treated as untrusted. Add the following checks to\nefi_loader_relocate():\n\n* Reject relocation blocks that don't start on a 32-bit aligned\n  address.\n* Reject relocation blocks whose SizeOfBlock is smaller than the\n  block header, which would cause an unsigned underflow when computing\n  the entry count.\n* A block with SizeOfBlock == 0 is invalid and does not mark the end of\n  the relocation table.\n* Reject relocation blocks that extend beyond the end of the\n  relocation section.\n* Reject individual relocation entries whose target offset, together\n  with the access width, exceeds the mapped image size, preventing\n  out-of-bounds writes.\n\nPass virt_size to efi_loader_relocate() from efi_load_pe() to enable\nthe per-entry bounds check.\n\nReported-by: Anas Cherni <anas@calif.io>\nReviewed-by: Simon Glass <sjg@chromium.org>\nReviewed-by: Ilias Apalodimas <ilias.apalodimas@linaro.org>\nSigned-off-by: Heinrich Schuchardt <heinrich.schuchardt@canonical.com>","tree":{"sha":"48d7d131fe831f3328e82603357a600564a3f14f","url":"https://api.github.com/repos/u-boot/u-boot/git/trees/48d7d131fe831f3328e82603357a600564a3f14f"},"url":"https://api.github.com/repos/u-boot/u-boot/git/commits/bc82aa5b4145eba47f57e6f7148e0fa45bc16f51","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/u-boot/u-boot/commits/bc82aa5b4145eba47f57e6f7148e0fa45bc16f51","html_url":"https://github.com/u-boot/u-boot/commit/bc82aa5b4145eba47f57e6f7148e0fa45bc16f51","comments_url":"https://api.github.com/repos/u-boot/u-boot/commits/bc82aa5b4145eba47f57e6f7148e0fa45bc16f51/comments","author":{"login":"xypron","id":2747104,"node_id":"MDQ6VXNlcjI3NDcxMDQ=","avatar_url":"https://avatars.githubusercontent.com/u/2747104?v=4","gravatar_id":"","url":"https://api.github.com/users/xypron","html_url":"https://github.com/xypron","followers_url":"https://api.github.com/users/xypron/followers","following_url":"https://api.github.com/users/xypron/following{/other_user}","gists_url":"https://api.github.com/users/xypron/gists{/gist_id}","starred_url":"https://api.github.com/users/xypron/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xypron/subscriptions","organizations_url":"https://api.github.com/users/xypron/orgs","repos_url":"https://api.github.com/users/xypron/repos","events_url":"https://api.github.com/users/xypron/events{/privacy}","received_events_url":"https://api.github.com/users/xypron/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"xypron","id":2747104,"node_id":"MDQ6VXNlcjI3NDcxMDQ=","avatar_url":"https://avatars.githubusercontent.com/u/2747104?v=4","gravatar_id":"","url":"https://api.github.com/users/xypron","html_url":"https://github.com/xypron","followers_url":"https://api.github.com/users/xypron/followers","following_url":"https://api.github.com/users/xypron/following{/other_user}","gists_url":"https://api.github.com/users/xypron/gists{/gist_id}","starred_url":"https://api.github.com/users/xypron/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xypron/subscriptions","organizations_url":"https://api.github.com/users/xypron/orgs","repos_url":"https://api.github.com/users/xypron/repos","events_url":"https://api.github.com/users/xypron/events{/privacy}","received_events_url":"https://api.github.com/users/xypron/received_events","type":"User","user_view_ty