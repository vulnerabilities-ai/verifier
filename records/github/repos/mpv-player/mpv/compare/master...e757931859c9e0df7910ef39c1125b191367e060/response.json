ch causes\neither invalid memory accesses when memory allocations are wrong size or\nhuge allocations leading to OOM.\n\nReported by: Trail of Bits","tree":{"sha":"ad5be1e3b4d0191a1d70c3d3dec8880c596d2abb","url":"https://api.github.com/repos/mpv-player/mpv/git/trees/ad5be1e3b4d0191a1d70c3d3dec8880c596d2abb"},"url":"https://api.github.com/repos/mpv-player/mpv/git/commits/e757931859c9e0df7910ef39c1125b191367e060","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/mpv-player/mpv/commits/e757931859c9e0df7910ef39c1125b191367e060","html_url":"https://github.com/mpv-player/mpv/commit/e757931859c9e0df7910ef39c1125b191367e060","comments_url":"https://api.github.com/repos/mpv-player/mpv/commits/e757931859c9e0df7910ef39c1125b191367e060/comments","author":{"login":"kasper93","id":1126053,"node_id":"MDQ6VXNlcjExMjYwNTM=","avatar_url":"https://avatars.githubusercontent.com/u/1126053?v=4","gravatar_id":"","url":"https://api.github.com/users/kasper93","html_url":"https://github.com/kasper93","followers_url":"https://api.github.com/users/kasper93/followers","following_url":"https://api.github.com/users/kasper93/following{/other_user}","gists_url":"https://api.github.com/users/kasper93/gists{/gist_id}","starred_url":"https://api.github.com/users/kasper93/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kasper93/subscriptions","organizations_url":"https://api.github.com/users/kasper93/orgs","repos_url":"https://api.github.com/users/kasper93/repos","events_url":"https://api.github.com/users/kasper93/events{/privacy}","received_events_url":"https://api.github.com/users/kasper93/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"kasper93","id":1126053,"node_id":"MDQ6VXNlcjExMjYwNTM=","avatar_url":"https://avatars.githubusercontent.com/u/1126053?v=4","gravatar_id":"","url":"https://api.github.com/users/kasper9