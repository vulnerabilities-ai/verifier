[{"url":"https://api.github.com/repos/libarchive/libarchive/pulls/2983","id":3586600325,"node_id":"PR_kwDOADEhXM7Vxy2F","html_url":"https://github.com/libarchive/libarchive/pull/2983","diff_url":"https://github.com/libarchive/libarchive/pull/2983.diff","patch_url":"https://github.com/libarchive/libarchive/pull/2983.patch","issue_url":"https://api.github.com/repos/libarchive/libarchive/issues/2983","number":2983,"state":"closed","locked":false,"title":"[iso9660] Fix joliet pathname overflow","user":{"login":"kientzle","id":1398793,"node_id":"MDQ6VXNlcjEzOTg3OTM=","avatar_url":"https://avatars.githubusercontent.com/u/1398793?v=4","gravatar_id":"","url":"https://api.github.com/users/kientzle","html_url":"https://github.com/kientzle","followers_url":"https://api.github.com/users/kientzle/followers","following_url":"https://api.github.com/users/kientzle/following{/other_user}","gists_url":"https://api.github.com/users/kientzle/gists{/gist_id}","starred_url":"https://api.github.com/users/kientzle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kientzle/subscriptions","organizations_url":"https://api.github.com/users/kientzle/orgs","repos_url":"https://api.github.com/users/kientzle/repos","events_url":"https://api.github.com/users/kientzle/events{/privacy}","received_events_url":"https://api.github.com/users/kientzle/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks to Anthropic for reporting this:\r\n> When libarchive reads an ISO 9660 image that uses the Joliet extension with deeply nested directories containing near-maximum-length UCS-2 filenames, the build_pathname_utf16be() function writes a UTF-16BE path separator (0x00 0x2F) two bytes past the end of a fixed 1024-byte heap buffer. The vulnerable code writes the separator without first verifying that the buffer still has space, relying only on a subsequent bounds check that fires too late — after the overflow has occurred. An attacker who can supply a crafted ISO image (for example, as a disc image or container format) to any application that uses libarchive to read archives can trigger this bug. At a minimum this causes a reliable crash (denial of service); on allocator-hardened builds the 2-byte write may reach heap metadata or an adjacent object, which on un-hardened targets could be further developed into code execution.\r\n\r\n","created_at":"2026-04-26T22:23:31Z","updated_at":"2026-05-02T16:09:48Z","closed_at":"2026-05-02T16:09:48Z","merged_at":"2026-05-02T16:09:48Z","merge_commit_sha":"0755b9eba0b38b3f11d60e78b7a8d74930b7e993","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/libarchive/libarchive/pulls/2983/commits","review_comments_url":"https://api.github.com/repos/libarchive/libarchive/pulls/2983/comments","review_comment_url":"https://api.github.com/repos/libarchive/libarchive/pulls/comments{/number}","comments_url":"https://api.github.com/repos/libarchive/libarchive/issues/2983/comments","statuses_url":"https://api.github.com/repos/libarchive/libarchive/statuses/750e8d7b25deeb67a976ab0c9f482ec1d2ac68a4","head":{"label":"kientzle:kientzle-iso9660-joliet-pathname","ref":"kientzle-iso9660-joliet-pathname","sha":"750e8d7b25deeb67a976ab0c9f482ec1d2ac68a4","user":{"login":"kientzle","id":1398793,"node_id":"MDQ6VXNlcjEzOTg3OTM=","avatar_url":"https://avatars.githubusercontent.com/u/1398793?v=4","gravatar_id":"","url":"https://api.github.com/users/kientzle","html_url":"https://github.com/kientzle","followers_url":"https://api.github.com/users/kientzle/followers","following_url":"https://api.github.com/users/kientzle/following{/other_user}","gists_url":"https://api.github.com/users/kientzle/gists{/gist_id}","starred_url":"https://api.github.com/users/kientzle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kientzle/subscriptions","organizations_url":"https://api.github.com/users/kientz