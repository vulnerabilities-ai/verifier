":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"641f2ddf0e474fb696b9e236253ed0dc27a40a6d","url":"https://api.github.com/repos/wolfSSL/wolfssl/commits/641f2ddf0e474fb696b9e236253ed0dc27a40a6d","html_url":"https://github.com/wolfSSL/wolfssl/commit/641f2ddf0e474fb696b9e236253ed0dc27a40a6d"},{"sha":"14b6fe2ae940eb89b0f1c6fc2c88fb08313632d4","url":"https://api.github.com/repos/wolfSSL/wolfssl/commits/14b6fe2ae940eb89b0f1c6fc2c88fb08313632d4","html_url":"https://github.com/wolfSSL/wolfssl/commit/14b6fe2ae940eb89b0f1c6fc2c88fb08313632d4"}]},"merge_base_commit":{"sha":"13a016367ff4b4d3cc4c9bc2bfdfe692a512dd81","node_id":"C_kwDOAblqCtoAKDEzYTAxNjM2N2ZmNGI0ZDNjYzRjOWJjMmJmZGZlNjkyYTUxMmRkODE","commit":{"author":{"name":"Tobias Frauenschläger","email":"tobias@wolfssl.com","date":"2026-03-30T09:57:53Z"},"committer":{"name":"Tobias Frauenschläger","email":"tobias@wolfssl.com","date":"2026-04-02T10:35:15Z"},"message":"eccsi: fix universal signature forgery via r=0/s=0\n\nwc_VerifyEccsiHash did not validate that r and s lie in [1, q-1]\nafter decoding them from the signature buffer.  With s=0 the scalar\nmultiplication [s](...) returns the point at infinity (J_x=0); with\nr=0 the final mp_cmp(0,0)==MP_EQ check then accepts the forged\nsignature unconditionally against any message and any identity.\n\nAdd [1, q-1] range checks for r (in wc_VerifyEccsiHash, after params\nare loaded) and for s (in eccsi_calc_j, after eccsi_decode_sig_s),\nmirroring the checks already present in wc_ecc_check_r_s_range.\nAdd a defense-in-depth point-at-infinity guard on J before the final\ncomparison.\n\nReported-by: Nicholas Carlini (Anthropic) & Bronson Yen (Calif.io)","tree":{"sha":"4b664adf76cb129518f69da88096f7cd41cbaca8","url":"https://api.github.com/repos/wolfSSL/wolfssl/git/trees/4b664adf76cb129518f69da88096f7cd41cbaca8"},"url":"https://api.github.com/repos/wolfSSL/wolfssl/git/commits/13a016367ff4b4d3cc4c9bc2bfdfe692a512dd81","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/wolfSSL/wolfssl/commits/13a016367ff4b4d3cc4c9bc2bfdfe692a512dd81","html_url":"https://github.com/wolfSSL/wolfssl/commit/13a016367ff4b4d3cc4c9bc2bfdfe692a512dd81","comments_url":"https://api.github.com/repos/wolfSSL/wolfssl/commits/13a016367ff4b4d3cc4c9bc2bfdfe692a512dd81/comments","author":{"login":"Frauschi","id":5159151,"node_id":"MDQ6VXNlcjUxNTkxNTE=","avatar_url":"https://avatars.githubusercontent.com/u/5159151?v=4","gravatar_id":"","url":"https://api.github.com/users/Frauschi","html_url":"https://github.com/Frauschi","followers_url":"https://api.github.com/users/Frauschi/followers","following_url":"https://api.github.com/users/Frauschi/following{/other_user}","gists_url":"https://api.github.com/users/Frauschi/gists{/gist_id}","starred_url":"https://api.github.com/users/Frauschi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Frauschi/subscriptions","organizations_url":"https://api.github.com/users/Frauschi/orgs","repos_url":"https://api.github.com/users/Frauschi/repos","events_url":"https://api.github.com/users/Frauschi/events{/privacy}","received_events_url":"https://api.github.com/users/Frauschi/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Frauschi","i