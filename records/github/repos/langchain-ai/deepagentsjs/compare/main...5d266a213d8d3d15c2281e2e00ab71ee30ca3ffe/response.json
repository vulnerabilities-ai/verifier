er","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"035f19b1b386add02ee3aaa8af429bb85baf8bfa","url":"https://api.github.com/repos/langchain-ai/deepagentsjs/commits/035f19b1b386add02ee3aaa8af429bb85baf8bfa","html_url":"https://github.com/langchain-ai/deepagentsjs/commit/035f19b1b386add02ee3aaa8af429bb85baf8bfa"}]},"merge_base_commit":{"sha":"5d266a213d8d3d15c2281e2e00ab71ee30ca3ffe","node_id":"C_kwDOPYJc-NoAKDVkMjY2YTIxM2Q4ZDNkMTVjMjI4MWUyZTAwYWI3MWVlMzBjYTNmZmU","commit":{"author":{"name":"Hunter Lovell","email":"40191806+hntrl@users.noreply.github.com","date":"2026-06-02T19:47:14Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-02T19:47:14Z"},"message":"refactor(node-vfs): make VfsSandbox filesystem-only (#575)\n\n## Summary\n\nThis PR removes command-execution semantics from `@langchain/node-vfs`\nand aligns `VfsSandbox` with `BackendProtocolV2` as a filesystem-only\nbackend.\n\nThe provider no longer uses sandbox execution abstractions and now\nperforms core file operations directly against the in-memory VFS.\n\n## Changes\n\n### Protocol alignment\n\n- `VfsSandbox` now implements `BackendProtocolV2` directly instead of\nextending sandbox/base-execution abstractions.\n- Removed command execution from the provider surface (`execute` is no\nlonger part of this backend implementation).\n- Removed `timeout` from `VfsSandboxOptions` and corresponding docs.\n\n### Runtime behavior\n\n- Added native backend implementations for:\n  - `read`\n  - `readRaw`\n  - `write`\n  - `edit`\n  - `ls`\n  - `grep`\n  - `glob`\n- Kept upload/download support and added path confinement handling for\ninvalid traversal paths.\n- Continued in-memory VFS-only operation (no temp-dir shell sync path).\n\n### Tests and docs\n\n- Updated unit and integration tests to remove execute-focused\nassertions and validate filesystem behavior.\n- Updated package docs to describe `BackendProtocolV2` usage and removed\nexecute/timeout references.\n- Added changeset for `@langchain/node-vfs`.","tree":{"sha":"b7ef676089b241d2fbae036c20fb4dc9a2fc92e0","url":"https://api.github.com/repos/langchain-ai/deepagentsjs/git/trees/b7ef676089b241d2fbae036c20fb4dc9a2fc92e0"},"url":"https://api.github.com/repos/langchain-ai/deepagentsjs/git/commits/5d266a213d8d3d15c2281e2e00ab71ee30ca3ffe","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqHzNCCRC1aQ7uu5UhlAAATjgQAFr6U/QnVr8g2QYE8v4lv1vo\n1AQxrOX96wqWcl4OtuqZeGQck2WtLKl0IVAWrsWX7xTYkJwV8A0PTJhXwxZOq98S\nkEjtRi8eZm/e+zByHNbf1aXiZtZP7Juy6SB4fZIOXUuSaoThKw36UlTPZYJLc/ng\nGsmyXP6/hp0vW/9kcvPxpb+jN4VArdGoMutMJVpRdMgHbNpWAD90x+5+T+nC3iMd\nIpF1284K2/+pc7IUYSPHb31uYikY6xwjkIaZWP2qmBU33is3wENymt2cIEDSmtRZ\njx+fCRMFEAFKazGTpf98tD+reP1Us7asESXmKBJkT5GFZwEGzyMx2b+isjSIW5cJ\njxa2QlR5cZjpCiKbSLU1L57UwfxOrSSl5wl7LJsctpEpZWARvF8SzRjnp5tTK8yt\ntRRw67F1+8Ue6TlIg/S5SCim1vgO8kTsgonp+4iuHCQQwquDVbqZLAmw4pE1kPnF\n4SsBqzZZBsPBb/qkRGJJmDkM4xl/AioCXD+QG9KBck5t2tcbx0dEcr4AYNc4WqmQ\nR5W+422/IVxuqwbzRSRiVmi26He4SczZvgIS/9LlTNe8HgUSZnEi1WPaKfekkYq6\noHUeN336D4Bo+0yjchfR0pxzpoZJkjnqXFg/+LHdMd5QIz6AaU55RC7PwuahUra/\nXOBhxqRHMlGSUTsaXUT9\n=375X\n-----END PGP SIGNATURE-----\n","payload":"tree b7ef676089b241d2fbae036c20fb4dc9a2fc92e0\nparent b7a5f26fd9cba992b11e1a4cf18607d64533503b\nauthor Hunter Lovell <40191806+hntrl@users.noreply.github.com> 1780429634 -0700\ncommitter GitHub <noreply@github.com> 1780429634 +0000\n\nrefactor(node-vfs): make VfsSandbox filesystem-only (#575)\n\n## Summary\n\nThis PR removes command-execution semantics from `@langchain/node-vfs`\nand aligns `VfsSandbox` with `BackendProtocolV2` as a filesystem-only\nbackend.\n\nThe provider no longer uses sandbox execution abstractions and now\nperforms core file operations directly against the in-memory VFS.\n\n## Changes\n\n### Protocol alignment\n\n- `VfsSandbox` now implements `BackendProtocolV2` directly instead of\nextending sandbox/base-execution abstractions.\n- Removed command execution from the provider surface (`execute` is no\nlonger part of this backend implementation).\n- Removed `timeout` from `VfsSandboxOptions` and corresponding docs.\n\n### Runtime behavior\n\n- Added native backend implementations for:\n  - `read`\n  - `readRaw`\n  - `write`\n  - `edit`\n  - `ls`\n  - `grep`\n  - `glob`\n- Kept upload/download support and added path confinement handling for\ninvalid traversal paths.\n- Continued in-memory VFS-only operation (no temp-dir shell sync path).\n\n### Tests and docs\n\n- Updated unit and integration tests to remove execute-focused\nassertions and validate filesystem behavior.\n- Updated package docs to describe `BackendProtocolV2` usage and removed\nexecute/timeout references.\n- Added changeset for `@langchain/node-vfs`.","verified_at":"2026-06-02T19:47:15Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagentsjs/commits/5d266a213d8d3d15c2281e2e00ab71ee30ca3ffe","html_url":"https://github.com/langchain-ai/deepagentsjs/commit/5d266a213d8d3d15c2281e2e00ab71ee30ca3ffe","com