C_kwDOAUV2jtoAKGM5YmQ0OTgyOGY0ZTljZDhjMDRmOTBhYWNiMTFlMjIzODAxNmJjMzE","commit":{"author":{"name":"John Thacker","email":"johnthacker@gmail.com","date":"2026-07-06T18:11:36Z"},"committer":{"name":"John Thacker","email":"johnthacker@gmail.com","date":"2026-07-06T21:23:14Z"},"message":"z3950: Use a wmem_array to avoid overflow\n\nSizing the directory array ahead of time can lead to issues when\nthere are partial records, as floor division is used for sizing\nbut a partial record can be added to the array. To eliminate the\nchance of a buffer overflow, use a wmem_array, add each new entry\nto the entry, and then read the count at the end.\n\nThe error handling should probably be cleaned up more, both for\noverflow and for illegal directory entries, but this prevents the\nbiggest issue.\n\nFix #21397\n\nThanks to Anthropic and Ada Logics for the report and PoC.","tree":{"sha":"1f92ef6274efb65a35fcfdd4c3d25cec69cd32bf","url":"https://api.github.com/repos/wireshark/wireshark/git/trees/1f92ef6274efb65a35fcfdd4c3d25cec69cd32bf"},"url":"https://api.github.com/repos/wireshark/wireshark/git/commits/c9bd49828f4e9cd8c04f90aacb11e2238016bc31","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/wireshark/wireshark/commits/c9bd49828f4e9cd8c04f90aacb11e2238016bc31","html_url":"https://github.com/wireshark/wireshark/commit/c9bd49828f4e9cd8c04f90aacb11e2238016bc31","comments_url":"https://api.github.com/repos/wireshark/wireshark/commits/c9bd49828f4e9cd8c04f90aacb11e2238016bc31/comments","author":{"login":"johnthacker","id":17785741,"node_id":"MDQ6VXNlcjE3Nzg1NzQx","avatar_url":"https://avatars.githubusercontent.com/u/17785741?v=4","gravatar_id":"","url":"https://api.github.com/users/johnthacker","html_url":"https://github.com/johnthacker","followers_url":"https://api.github.com/users/johnthacker/followers","following_url":"https://api.github.com/users/johnthacker/following{/othe