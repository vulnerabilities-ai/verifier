C_kwDOAUV2jtoAKDY4YTkxNDUyYWZjMGE2OGIzNzMxNGVmYTk2OWI5MjMyZTFlYzY3MTE","commit":{"author":{"name":"John Thacker","email":"johnthacker@gmail.com","date":"2026-07-06T01:46:47Z"},"committer":{"name":"AndersBroman","email":"a.broman58@gmail.com","date":"2026-07-06T06:08:34Z"},"message":"IEEE 802.11 crypt: Check for too large values in EAPOL frames\n\nHave get_eapol_parsed return false if the values are bogus, and don't\ncall the crypt functions to inspect the parsed EAPOL frame if that's\nthe case.\n\nThe IEEE 802.11 dissector is the one that allocates the decrypted\ndata frame array. Rather than just agreeing it will be a certain\nsize, have the initial value of the length in,out parameter passed\nin contain the allocated size, so that Dot11DecryptDecryptKeyData\ncan refuse to copy too large values.\n\nFix #21391\n\nThanks to Anthropic Claude and Ada Logics for the report and PoC.","tree":{"sha":"bc2cd81caeeb7f1d5bf1b9958cc1301df3a36118","url":"https://api.github.com/repos/wireshark/wireshark/git/trees/bc2cd81caeeb7f1d5bf1b9958cc1301df3a36118"},"url":"https://api.github.com/repos/wireshark/wireshark/git/commits/68a91452afc0a68b37314efa969b9232e1ec6711","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/wireshark/wireshark/commits/68a91452afc0a68b37314efa969b9232e1ec6711","html_url":"https://github.com/wireshark/wireshark/commit/68a91452afc0a68b37314efa969b9232e1ec6711","comments_url":"https://api.github.com/repos/wireshark/wireshark/commits/68a91452afc0a68b37314efa969b9232e1ec6711/comments","author":{"login":"johnthacker","id":17785741,"node_id":"MDQ6VXNlcjE3Nzg1NzQx","avatar_url":"https://avatars.githubusercontent.com/u/17785741?v=4","gravatar_id":"","url":"https://api.github.com/users/johnthacker","html_url":"https://github.com/johnthacker","followers_url":"https://api.github.com/users/johnthacker/followers","following_url":"https://api.github.com/users/johnth