ry_test.go","status":"added","additions":18,"deletions":0,"changes":18,"blob_url":"https://github.com/openmeterio/openmeter/blob/6ce29e743165890c10346f4c71d5bf79f1ecaf6f/openmeter%2Fstreaming%2Fclickhouse%2Futils_query_test.go","raw_url":"https://github.com/openmeterio/openmeter/raw/6ce29e743165890c10346f4c71d5bf79f1ecaf6f/openmeter%2Fstreaming%2Fclickhouse%2Futils_query_test.go","contents_url":"https://api.github.com/repos/openmeterio/openmeter/contents/openmeter%2Fstreaming%2Fclickhouse%2Futils_query_test.go?ref=6ce29e743165890c10346f4c71d5bf79f1ecaf6f","patch":"@@ -0,0 +1,18 @@\n+package clickhouse\n+\n+import (\n+\t\"testing\"\n+\n+\t\"github.com/stretchr/testify/assert\"\n+)\n+\n+func Test_ValidateJsonPathQuery(t *testing.T) {\n+\tquery, args := validateJsonPathQuery{\n+\t\tjsonPath: \"$.foo.bar\",\n+\t}.toSQL()\n+\n+\tassert.Equal(t, `SELECT JSON_VALUE('{}', ?)`, query)\n+\tassert.Equal(t, []interface{}{\n+\t\t\"$.foo.bar\",\n+\t}, args)\n+}"}]}