eAuthentication no/g' \\\n+    /etc/ssh/sshd_config\n+  grep -qE \"^PasswordAuthentication\\s+no\" /etc/ssh/sshd_config \\\n+    || { echo \"ERROR: PasswordAuthentication is not disabled in sshd_config\"; exit 1; }\n }\n \n install_nix"}]}