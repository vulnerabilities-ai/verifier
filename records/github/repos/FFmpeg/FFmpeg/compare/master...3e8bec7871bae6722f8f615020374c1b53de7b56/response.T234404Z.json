,"gravatar_id":"","url":"https://api.github.com/users/toots","html_url":"https://github.com/toots","followers_url":"https://api.github.com/users/toots/followers","following_url":"https://api.github.com/users/toots/following{/other_user}","gists_url":"https://api.github.com/users/toots/gists{/gist_id}","starred_url":"https://api.github.com/users/toots/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/toots/subscriptions","organizations_url":"https://api.github.com/users/toots/orgs","repos_url":"https://api.github.com/users/toots/repos","events_url":"https://api.github.com/users/toots/events{/privacy}","received_events_url":"https://api.github.com/users/toots/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"jamrial","id":2442845,"node_id":"MDQ6VXNlcjI0NDI4NDU=","avatar_url":"https://avatars.githubusercontent.com/u/2442845?v=4","gravatar_id":"","url":"https://api.github.com/users/jamrial","html_url":"https://github.com/jamrial","followers_url":"https://api.github.com/users/jamrial/followers","following_url":"https://api.github.com/users/jamrial/following{/other_user}","gists_url":"https://api.github.com/users/jamrial/gists{/gist_id}","starred_url":"https://api.github.com/users/jamrial/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jamrial/subscriptions","organizations_url":"https://api.github.com/users/jamrial/orgs","repos_url":"https://api.github.com/users/jamrial/repos","events_url":"https://api.github.com/users/jamrial/events{/privacy}","received_events_url":"https://api.github.com/users/jamrial/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"24c2676ea52dfcb755b04960ca3a9de1bee24d6b","url":"https://api.github.com/repos/FFmpeg/FFmpeg/commits/24c2676ea52dfcb755b04960ca3a9de1bee24d6b","html_url":"https://github.com/FFmpeg/FFmpeg/commit/24c2676ea52dfcb755b04960ca3a9de1bee24d6b"}]},"merge_base_commit":{"sha":"3e8bec7871bae6722f8f615020374c1b53de7b56","node_id":"C_kwDOABiiStoAKDNlOGJlYzc4NzFiYWU2NzIyZjhmNjE1MDIwMzc0YzFiNTNkZTdiNTY","commit":{"author":{"name":"Nicholas Carlini","email":"nicholas@carlini.com","date":"2026-03-15T23:10:51Z"},"committer":{"name":"michaelni","email":"michael@niedermayer.cc","date":"2026-03-16T11:51:27Z"},"message":"avformat/mpegts: fix descriptor accounting across multiple IOD descriptors\n\npmt_cb() passes mp4_descr + mp4_descr_count as the output base but\nMAX_MP4_DESCR_COUNT (16) as the capacity, not the remaining capacity.\ninit_MP4DescrParseContext() resets d->descr_count to 0 on every call,\nso the bounds check at parse_MP4ESDescrTag compares a fresh 0 against\n16 regardless of the shifted base.\n\nA PMT with two IOD descriptors of 16 ESDescrs each will crash. The first\nfills the buffer mp4_descr[0..15], and then the second writes\nmp4_descr[16..31] -- 1152 bytes past the end of the stack.\n\nThis change passes the remaining capacity instead of always passing 16.\nThe writeback in mp4_read_iods is incremented so the caller's running\ncount is preserved.\n\nFixes: stack-buffer-overflow\n\nFound-by: Nicholas Carlini <nicholas@carlini.com>","tree":{"sha":"71a093116eb913353d79bf375138525a483435e7","url":"https://api.github.com/repos/FFmpeg/FFmpeg/git/trees/71a093116eb913353d79bf375138525a483435e7"},"url":"https://api.github.com/repos/FFmpeg/FFmpeg/git/commits/3e8bec7871bae6722f8f615020374c1b53de7b56","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/FFmpeg/FFmpeg/commits/3e8bec7871bae6722f8f615020374c1b53de7b56","html_url":"https://github.com/FFmpeg/FFmpeg/commit/3e8bec7871bae6722f8f615020374c1b53de7b56","comments_url":"https://api.github.com/repos/FFmpeg/FFmpeg/commits/3e8bec7871bae6722f8f615020374c1b53de7b56/comments","author":{"login":"carlini","id":1269300,"node_id":"MDQ6VXNlcjEyNjkzMDA=","avatar_url":"https://avatars.githubusercontent.com/u/12